{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "R6 Tactical Studio",
  "version": "0.2.1",
  "identifier": "com.zyxzbb.r6-tactical-studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "R6 Tactical Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["mty"],
        "name": "R6 Tactical Project",
        "description": "R6 Tactical Studio Project File",
        "role": "Editor"
      }
    ]
  }
}
